<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>{{title}}</title>
  <!--[if mso]>
  <style type="text/css">
    body, table, td {font-family: Arial, sans-serif !important;}
  </style>
  <![endif]-->
</head>
<body style="margin:0;padding:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;background-color:transparent;line-height:1.6;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;">
  <!-- Preheader -->
  <div style="display:none;font-size:1px;color:transparent;line-height:1px;max-height:0px;max-width:0px;opacity:0;overflow:hidden;">
    {{#if header}}{{header}}{{/if}}
  </div>
  
  <!-- Main wrapper -->
  <!-- NOTE: avoid modern CSS (flex/clamp/rem/transition) for better email client compatibility -->
  <table role="presentation" style="width:100%;border-collapse:collapse;background-color:transparent;">
    <tr>
      <td align="center" style="padding:40px 20px;">
        <!-- Email container -->
        <table role="presentation" style="width:100%;max-width:600px;border-collapse:separate;border-spacing:0;background-color:#0e0e10;border:1px solid rgba(241,241,242,0.10);border-radius:24px;overflow:hidden;">
          
          <!-- Header -->
          <tr>
            <td style="padding:32px 28px 20px;border-bottom:1px solid rgba(241,241,242,0.08);text-align:center;">
              {{#if logoBase64}}
                <img src="{{logoBase64}}" alt="Unlock" style="height:48px;width:auto;display:inline-block;max-width:100%;border:0;outline:none;text-decoration:none;" />
              {{else}}
                <h1 style="margin:0;color:#f1f1f2;font-size:28px;font-weight:700;letter-spacing:-0.02em;line-height:1.2;">Unlock</h1>
              {{/if}}
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding:28px;">
              
              <p style="margin:0 0 22px;color:rgba(241,241,242,0.55);font-size:13px;letter-spacing:0.3px;font-weight:500;text-align:center;">Centre de formation - IA & Tech</p>
              
              {{#if header}}
              <h2 style="margin:0 0 18px;color:#f1f1f2;font-size:20px;font-weight:650;line-height:1.3;letter-spacing:-0.01em;">{{header}}</h2>
              {{/if}}

              {{#if greeting}}
              <div style="color:rgba(241,241,242,0.90);font-size:15px;line-height:1.7;margin-bottom:18px;">
                {{{greeting}}}
              </div>
              {{/if}}

              {{#if mainMessage}}
              <div style="color:rgba(241,241,242,0.84);font-size:15px;line-height:1.7;margin-bottom:22px;">
                {{{mainMessage}}}
              </div>
              {{/if}}

              {{#if infoBox}}
              <table role="presentation" style="width:100%;border-collapse:separate;border-spacing:0;background-color:#0b0b0c;border:1px solid rgba(241,241,242,0.12);border-left:3px solid #cfeeff;border-radius:16px;margin:22px 0;">
                <tr>
                  <td style="padding:20px;">
                    {{#if infoBox.title}}
                    <p style="margin:0 0 12px;color:#f1f1f2;font-size:15px;font-weight:650;letter-spacing:-0.01em;">{{infoBox.title}}</p>
                    {{/if}}

                    {{#if infoBox.items}}
                    <ul style="margin:0;padding-left:18px;color:rgba(241,241,242,0.84);font-size:14px;line-height:1.8;">
                      {{#each infoBox.items}}
                      <li style="margin-bottom:8px;">{{this}}</li>
                      {{/each}}
                    </ul>
                    {{/if}}

                    {{#if infoBox.content}}
                    <p style="margin:0;color:rgba(241,241,242,0.84);font-size:14px;line-height:1.7;">{{{infoBox.content}}}</p>
                    {{/if}}

                    {{#if infoBox.details}}
                    <table role="presentation" style="width:100%;border-collapse:collapse;margin-top:12px;">
                      {{#each infoBox.details}}
                      <tr>
                        <td style="padding:10px 0;color:rgba(241,241,242,0.55);font-size:14px;border-bottom:1px solid rgba(241,241,242,0.08);"><strong style="color:rgba(241,241,242,0.92);font-weight:600;">{{this.label}}</strong></td>
                        <td style="padding:10px 0;color:#f1f1f2;font-size:14px;font-weight:600;text-align:right;border-bottom:1px solid rgba(241,241,242,0.08);">{{this.value}}</td>
                      </tr>
                      {{/each}}
                    </table>
                    {{/if}}
                  </td>
                </tr>
              </table>
              {{/if}}

              {{#if additionalMessage}}
              <p style="margin:18px 0;color:rgba(241,241,242,0.84);font-size:15px;line-height:1.7;">{{{additionalMessage}}}</p>
              {{/if}}

              {{#if buttonUrl}}
              <table role="presentation" style="width:100%;border-collapse:collapse;margin:24px 0;">
                <tr>
                  <td align="center" style="padding:0;">
                    <a href="{{buttonUrl}}" style="display:inline-block;padding:14px 28px;background-color:#ffffff;color:#0b0b0c;text-decoration:none;border-radius:999px;font-weight:650;font-size:15px;letter-spacing:-0.01em;">
                      {{buttonText}}
                    </a>
                  </td>
                </tr>
              </table>
              {{/if}}

              {{#if messageBox}}
              <table role="presentation" style="width:100%;border-collapse:separate;border-spacing:0;background-color:#0b0b0c;border:1px solid rgba(241,241,242,0.12);border-radius:16px;margin:22px 0;">
                <tr>
                  <td style="padding:18px;">
                    <p style="margin:0;color:rgba(241,241,242,0.90);font-size:14px;line-height:1.7;">{{{messageBox}}}</p>
                  </td>
                </tr>
              </table>
              {{/if}}

              {{#if warning}}
              <table role="presentation" style="width:100%;border-collapse:separate;border-spacing:0;background-color:rgba(239,68,68,0.10);border:1px solid rgba(239,68,68,0.30);border-radius:16px;margin:22px 0;">
                <tr>
                  <td style="padding:16px;">
                    <p style="margin:0;color:rgba(254,226,226,0.95);font-size:14px;line-height:1.7;">
                      <strong style="color:#fecaca;font-weight:650;">Important :</strong> {{{warning}}}
                    </p>
                  </td>
                </tr>
              </table>
              {{/if}}

              {{#if linkInfo}}
              <p style="margin:22px 0;color:rgba(241,241,242,0.70);font-size:14px;line-height:1.7;text-align:center;">
                <a href="{{linkInfo.url}}" style="color:#cfeeff;text-decoration:none;font-weight:600;">{{linkInfo.label}}</a>
              </p>
              {{/if}}

              {{#if conclusion}}
              <p style="margin:26px 0 0;color:#f1f1f2;font-size:15px;font-weight:600;line-height:1.7;">{{{conclusion}}}</p>
              {{/if}}

              {{#if signature}}
              <p style="margin:10px 0 0;color:rgba(241,241,242,0.55);font-size:15px;font-style:italic;">{{signature}}</p>
              {{/if}}
              
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:22px 28px;background-color:#0b0b0c;border-top:1px solid rgba(241,241,242,0.08);text-align:center;">
              <p style="margin:0 0 6px;color:rgba(241,241,242,0.55);font-size:13px;line-height:1.6;">
                © {{currentYear}} <strong style="color:rgba(241,241,242,0.9);font-weight:650;">Unlock</strong>. Tous droits réservés.
              </p>
              <p style="margin:0 0 12px;color:rgba(241,241,242,0.40);font-size:12px;line-height:1.5;">
                Cet email a été envoyé automatiquement depuis notre plateforme sécurisée. Si vous n’êtes pas concerné, ignorez ce message.
              </p>
              <p style="margin:0;color:rgba(241,241,242,0.65);font-size:13px;line-height:1.6;">
                Contact : <a href="mailto:{{contactEmail}}" style="color:#cfeeff;text-decoration:none;font-weight:600;">{{contactEmail}}</a>
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
