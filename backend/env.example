# Server Configuration
NODE_ENV=development
PORT=4000

# Database Configuration (MAMP sur Mac)
DB_HOST=localhost
DB_PORT=8889
DB_NAME=webunlock
DB_USER=root
DB_PASSWORD=root
DB_DIALECT=mysql

# Sequelize Configuration
DB_SYNC=false
DB_FORCE_SYNC=false
DB_ALTER_SYNC=false

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Security
JWT_SECRET=your-secret-key-change-in-production
API_KEY=your-api-key-change-in-production

# Admin (change in production!)
ADMIN_EMAIL=admin@unlock.fr
ADMIN_PASSWORD=Admin123!@#

# CORS
# Development
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4000
# Production (à utiliser sur le serveur)
# ALLOWED_ORIGINS=https://unlock-formation.fr,https://www.unlock-formation.fr

# OpenAI (for AI training generation)
OPENAI_API_KEY=your-openai-api-key-here

# Email (SMTP) - configure in production
SMTP_HOST=smtp.ionos.fr
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-user@domain.tld
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_NAME=Unlock Formation

# France Compétences RNCP - Pas besoin de clé API, données publiques
# Le service récupère automatiquement les données depuis le site public
# https://www.francecompetences.fr/recherche/rncp/{code}/

