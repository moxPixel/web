<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (version compatible IONOS)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # SPA fallback: route all non-file requests to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions-Policy compatible IONOS → Feature-Policy (fallback)
  Header always set Feature-Policy "camera 'none'; microphone 'none'; geolocation 'none'; accelerometer 'none'"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/rss+xml application/atom+xml image/svg+xml
</IfModule>
